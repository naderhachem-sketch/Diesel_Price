# Copy this file to .env and adjust as needed. Every value has a built-in
# default (see config.py), so .env is optional.

MEDCO_URL=https://medco.com.lb/
SCRAPER_TIME=10:30
SCRAPER_TIMEZONE=Asia/Beirut
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
DIESEL_DB_PATH=diesel_price.db
